# Dentro de VM: use o endereço HTTPS válido e acessível do host; NÃO use 127.0.0.1.
# Em uma única máquina local, HTTP loopback é permitido para desenvolvimento.
EDU_API_URL=https://meu-host.minha-rede.ts.net
EDU_COMPUTER_ID=1
EDU_AGENT_TOKEN=COLE_O_TOKEN_GERADO_NO_SISTEMA
EDU_INTERVAL_SECONDS=60
EDU_DISK_PATH=C:\
