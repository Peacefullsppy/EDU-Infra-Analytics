# Execute PostgreSQL local em infra/ (porta 5433) ou configure o Session Pooler do Supabase.
# Percent-encode caracteres reservados na senha da URL (@ = %40, # = %23).
DATABASE_URL=postgresql+psycopg://edu_infra:troque-esta-senha@127.0.0.1:5433/edu_infra
JWT_SECRET_KEY=TROQUE-POR-UMA-CHAVE-ALEATORIA-GRANDE-GERADA-EM-SEGREDO
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUIRE_HTTPS=false
