digraph EDUInfra {
  graph [rankdir=LR, bgcolor="#ffffff", pad="0.35", nodesep="0.6", ranksep="0.9", splines=polyline, fontname="Arial", label="EDU-Infra Analytics — Arquitetura Semana 1 (monografia UMC)", labelloc=t, fontsize=19, fontcolor="#203958"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, penwidth=1.3, color="#6a8eae", fillcolor="#eef5fc", fontcolor="#19344d", margin="0.20,0.16"];
  edge [fontname="Arial", fontsize=11, color="#54799d", arrowsize=0.7];
  pessoa [label="Equipe TI / Gestor"];
  web [label="Frontend React\nfetch / JWT", fillcolor="#d6ebff"];
  api [label="FastAPI + Pydantic\nRBAC / Auditoria", fillcolor="#cceadb"];
  db [label="SQLAlchemy + Alembic\nSQLite testado / PostgreSQL alvo", shape=cylinder, fillcolor="#fff2cf", color="#a58d5a"];
  agente [label="Agente Python + psutil\nFUTURO", style="rounded,dashed,filled", fillcolor="#f2f2f2", color="#8b8b8b"];
  pc [label="Computadores dos laboratórios\nFUTURO na coleta", style="rounded,dashed,filled", fillcolor="#f2f2f2", color="#8b8b8b"];
  pessoa -> web [label="Interface"];
  web -> api [label="HTTP + JSON"];
  api -> db [label="Persistência"];
  pc -> agente [style=dashed, label="Medição"];
  agente -> api [style=dashed, label="Métricas futuras"];
}
